@baseUrl = http://localhost:8080/api/v1

### =========================================================================
### 0. PREPARACIÓN DE PLANTILLA EN H2 (1 lesionado + 12 disponibles)
### =========================================================================

# Jugador ID 1 -> LESIONADO (para probar bloqueo en convocatoria)
POST {{baseUrl}}/players
Content-Type: application/json

{
  "firstName": "Pedri",
  "lastName": "González",
  "shirtNumber": 8,
  "birthDate": "2002-11-25",
  "position": "MIDFIELDER",
  "playerStatus": "INJURED"
}

###

