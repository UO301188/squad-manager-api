### =========================================================================
### 1. CREACIÓN Y LISTADO DE PARTIDOS
### =========================================================================

# Crear Partido ID 1 (Esperado: 201 Created, goalsFor y goalsAgainst en null)
POST {{baseUrl}}/matches
Content-Type: application/json

{
  "opponent": "Real Oviedo",
  "matchDate": "2026-12-06T18:30:00",
  "competition": "Liga",
  "homeMatch": true
}

###

# Crear Partido ID 2 con fecha anterior para verificar ordenación ascendente
POST {{baseUrl}}/matches
Content-Type: application/json

{
  "opponent": "Real Sporting",
  "matchDate": "2026-11-29T16:15:00",
  "competition": "Copa",
  "homeMatch": false
}

###

# Listar calendario ordenado por fecha (Esperado: 200 OK, primero ID 2 y luego ID 1)
GET {{baseUrl}}/matches
Accept: application/json


### =========================================================================
### 2. CONVOCATORIAS Y REGLAS DE NEGOCIO (Sobre Partido ID 1)
### =========================================================================

# Fallo: Convocar a jugador lesionado ID 1 (Esperado: 400 o 409 según tu GlobalExceptionHandler)
POST {{baseUrl}}/matches/1/appearances
Content-Type: application/json

{
  "playerId": 1,
  "callUpStatus": "STARTER"
}

###

# Convocar los 11 titulares válidos (Jugadores ID 2 al 12 -> Esperado: 201 Created)
POST {{baseUrl}}/matches/1/appearances
Content-Type: application/json

{ "playerId": 2, "callUpStatus": "STARTER" }
###
POST {{baseUrl}}/matches/1/appearances
Content-Type: application/json

{ "playerId": 3, "callUpStatus": "STARTER" }
