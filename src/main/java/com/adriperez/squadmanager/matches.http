POST {{baseUrl}}/matches/1/appearances
Content-Type: application/json

{ "playerId": 10, "callUpStatus": "STARTER" }
###
POST {{baseUrl}}/matches/1/appearances
Content-Type: application/json

{ "playerId": 11, "callUpStatus": "STARTER" }
###
POST {{baseUrl}}/matches/1/appearances
Content-Type: application/json

{ "playerId": 12, "callUpStatus": "STARTER" }

###

# Fallo: Intentar meter al jugador 13 como titular nº 12 (Esperado: BusinessRuleException)
POST {{baseUrl}}/matches/1/appearances
Content-Type: application/json

{
  "playerId": 13,
  "callUpStatus": "STARTER"
}

###

# Convocar al jugador 13 como SUPLENTE (Esperado: 201 Created)
POST {{baseUrl}}/matches/1/appearances
Content-Type: application/json

{
  "playerId": 13,
  "callUpStatus": "SUBSTITUTE"
}

###

# Fallo: Intentar convocar dos veces al jugador 2 en el mismo partido
POST {{baseUrl}}/matches/1/appearances
Content-Type: application/json

{
  "playerId": 2,
  "callUpStatus": "SUBSTITUTE"
}


### =========================================================================
### 3. ACTA POST-PARTIDO Y COHERENCIA DE ESTADÍSTICAS
### =========================================================================

# Fallo: Jugador 13 con 0 minutos pero registrando 1 gol (Esperado: BusinessRuleException)
PUT {{baseUrl}}/matches/1/appearances/13
Content-Type: application/json

{
  "callUpStatus": "SUBSTITUTE",
  "minutesPlayed": 0,
  "goals": 1,
  "assists": 0,
  "yellowCards": 0,
  "redCard": false
}

###

# Acta válida para jugador 10 (Titular, 90 min, 2 goles, 1 tarjeta amarilla -> Esperado: 200 OK)
PUT {{baseUrl}}/matches/1/appearances/10
Content-Type: application/json

{
  "callUpStatus": "STARTER",
  "minutesPlayed": 90,
  "goals": 2,
  "assists": 0,
  "yellowCards": 1,
  "redCard": false
}

###

# Acta válida para jugador 13 (Suplente que entra 25 min y da 1 asistencia -> Esperado: 200 OK)
PUT {{baseUrl}}/matches/1/appearances/13
Content-Type: application/json

{
  "callUpStatus": "SUBSTITUTE",
  "minutesPlayed": 25,
  "goals": 0,
  "assists": 1,
  "yellowCards": 0,
  "redCard": false
}


### =========================================================================
### 4. MARCADOR FINAL, FICHA DETALLADA (N+1 CHECK) Y BAJA DE CONVOCATORIA
### =========================================================================

# Actualizar marcador del partido 1 (Esperado: 200 OK)
PATCH {{baseUrl}}/matches/1/result
Content-Type: application/json

{
  "goalsFor": 2,
  "goalsAgainst": 1
}

###

# Obtener detalle completo del partido 1 (Esperado: 200 OK con 12 convocados y 1 sola SELECT en consola)
GET {{baseUrl}}/matches/1
Accept: application/json

###

# Eliminar al jugador 13 de la convocatoria (Esperado: 204 No Content)
DELETE {{baseUrl}}/matches/1/appearances/13

###

# Consultar partido inexistente (Esperado: 404 Not Found)
GET {{baseUrl}}/matches/999
Accept: application/json